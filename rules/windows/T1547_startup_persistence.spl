# Detection Rule: Startup Folder Persistence
# MITRE ATT&CK: T1547.001 - Registry Run Keys / Startup Folder
# Author: Vaibhav Joshi
# Date: 2026-09-23
# Description: Detects files dropped into the Windows Startup folder,
#              a common persistence technique used by malware.

index=main TargetFilename="*Startup*" | stats count by host | rename host as "Host" | table Host, count
